# 실행 프로필 (로컬: dev, 운영: 배포 환경에서 prod 지정)
SPRING_PROFILES_ACTIVE=dev

# Grafana (실제 비밀번호는 로컬 .env 또는 실행 환경에만 설정)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# PostgreSQL/Supabase
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=


# Supabase Storage (S3 호환 API, 서버 전용 키)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-northeast-2
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=user-profile-image
SUPABASE_STORAGE_PUBLIC_BASE_URL=

# Redis
REDIS_HOST=
REDIS_PORT=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth login callback page (exact absolute URI, no query or fragment)
OAUTH2_SUCCESS_REDIRECT_URI=

# Kakao 지도/식당 검색
KAKAO_MAP_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=

# JWT
JWT_ISSUER=project2
JWT_AUDIENCE=project2-api
# Base64로 인코딩한 32바이트 이상의 무작위 HMAC 비밀키
JWT_SECRET=

# 후기 운영 감사 로그용 HMAC 가명 키 (운영에서는 Secret Manager 사용, 32바이트 이상)
REVIEW_AUDIT_PSEUDONYM_KEY=
REVIEW_AUDIT_PSEUDONYM_KEY_VERSION=v1
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_CLEANUP_RETENTION=7d
AUTH_CLEANUP_CRON="0 0 4 * * *"

# Frontend CORS (exact origin, e.g. http://localhost:3000)
FRONTEND_ORIGIN=

# Google GenAI
GOOGLE_API_KEY=
# 비활성화 기본값: 실제 AI 호출 시 두 값을 google-genai로 변경
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
GOOGLE_AI_CHAT_MODEL=gemini-3.5-flash
GOOGLE_AI_EMBEDDING_MODEL=gemini-embedding-001
